# ==============================================================================
# MyTube Release Signing Keystore Configuration
# ==============================================================================
# Điền các thông tin bảo mật bên dưới để ký ứng dụng khi build Release.
# Không bao giờ commit file .env này lên Git!

# Đường dẫn tới file Keystore (.jks hoặc .keystore)
# Ví dụ: /storage/emulated/0/mytube-release.jks hoặc /data/data/com.termux/files/home/mytube-release.jks
KEYSTORE_FILE=

# Mật khẩu Keystore
KEYSTORE_PASSWORD=

# Tên định danh key (Alias) đã tạo trong Keystore
KEY_ALIAS=

# Mật khẩu cho Key Alias (thường đặt trùng với KEYSTORE_PASSWORD)
KEY_PASSWORD=

# Chuỗi Base64 của file Keystore (dùng để thêm vào GitHub Repo Secrets: RELEASE_KEYSTORE_BASE64)
# Tạo bằng lệnh: base64 -w 0 <đường_dẫn_keystore>
RELEASE_KEYSTORE_BASE64=
